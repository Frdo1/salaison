{
  "expo": {
    "name": "Calculatrice Salaison",
    "slug": "monapplihtml",
    "owner": "frdo1",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "salaison",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "android": {
      "package": "com.frdo1.monapplihtml",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundColor": "#FF5733"
      },
      "edgeToEdgeEnabled": true,
      "softwareKeyboardLayoutMode": "pan",
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FF5733"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "L'appli accède à vos photos pour la galerie de viandes séchées.",
          "cameraPermission": "L'appli utilise l'appareil photo pour photographier vos pièces.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF5733"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-calendar",
        {
          "calendarPermission": "L'appli ajoute les dates de fin de salage et de séchage à votre agenda."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7ae78162-f3eb-4e06-9de6-84fcb4c87d67"
      }
    }
  }
}
